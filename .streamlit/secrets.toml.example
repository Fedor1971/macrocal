# Streamlit Community Cloud > App settings > Secrets. Both keys are optional:
# without them the FRED section and the Ask tab are hidden.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = ""

# Google AI Studio key (outside the Claude subscription): https://aistudio.google.com/apikey
GEMINI_API_KEY = ""

